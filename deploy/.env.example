# Copia este archivo como .env (en la VPS, al lado de docker-compose.prod.yml) y llena los valores.
# El .env real NUNCA va a Git.

# Dirección pública. En la VPS: https://tu-subdominio.duckdns.org ; en tu computadora: http://localhost
SITE_ADDRESS=http://localhost
# misma dirección, para CORS y los enlaces de invitación
CORS_ORIGIN=http://localhost
APP_URL=http://localhost

# contraseña de la base (larga y al azar)
POSTGRES_PASSWORD=
# clave para firmar las sesiones: mínimo 32 caracteres al azar (por ejemplo: openssl rand -hex 32)
JWT_SECRET_KEY=

# opcionales
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_TO=
TZ=America/Costa_Rica

# imágenes a usar (las pone el despliegue automático; en local, las construidas a mano)
API_IMAGE=stockly-api:local
WEB_IMAGE=stockly-web:local
# puertos de la máquina (en tu computadora, si el 80 está ocupado, usa por ejemplo 8080)
HTTP_PORT=80
HTTPS_PORT=443
# en la VPS, detrás del nginx que ya existe:
#   SITE_ADDRESS=:80  BIND_ADDRESS=127.0.0.1  HTTP_PORT=8080  HTTPS_PORT=8443  TRUST_PROXY=2
#   (Caddy no pide certificado: el HTTPS lo pone nginx con certbot; ver nginx-stockly.conf)
BIND_ADDRESS=0.0.0.0
TRUST_PROXY=1
