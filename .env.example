# Copiar a .env y completar. Nunca subir .env al repo.
PORT=3000
# zona horaria de los días del negocio (por defecto America/Costa_Rica, ver src/config/timezone.ts)
# TZ=America/Costa_Rica
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/inventario_db
# La usa docker-compose.yml para crear la base: debe coincidir con la de DATABASE_URL
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL_TEST=postgresql://postgres:CAMBIAR@localhost:5432/inventario_db_test
# OBLIGATORIA (el servidor no arranca sin ella). En producción, mínimo 32 caracteres aleatorios.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
GEMINI_API_KEY=

# Orígenes del frontend permitidos (varios separados por coma)
CORS_ORIGIN=http://localhost:5173

# Email (Resend). Sin EMAIL_FROM = modo prueba: todo va a EMAIL_TEST_TO
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_TO=

# URL pública del frontend (links de invitación)
APP_URL=http://localhost:5173

# Producción: NODE_ENV=production y, si hay un proxy delante (Caddy/Nginx), TRUST_PROXY=1
# para que el límite de intentos use la IP real del cliente.
NODE_ENV=
TRUST_PROXY=0
