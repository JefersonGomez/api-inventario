# Copiar a .env y completar. Nunca subir .env al repo.
PORT=3000
# zona horaria de los días del negocio (por defecto America/Costa_Rica, ver src/config/timezone.ts)
# TZ=America/Costa_Rica
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/inventario_db
# La usa docker-compose.yml para crear la base: debe coincidir con la de DATABASE_URL
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL_TEST=postgresql://postgres:CAMBIAR@localhost:5432/inventario_db_test
# OBLIGATORIA (el servidor no arranca sin ella). En producción, mínimo 32 caracteres aleatorios.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
GEMINI_API_KEY=

# Orígenes del frontend permitidos (varios separados por coma)
CORS_ORIGIN=http://localhost:5173

# Email (Resend). Sin EMAIL_FROM = modo prueba: todo va a EMAIL_TEST_TO
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_TO=

# URL pública del frontend (links de invitación)
APP_URL=http://localhost:5173

# Producción: NODE_ENV=production y, si hay un proxy delante (Caddy/Nginx), TRUST_PROXY=1
# para que el límite de intentos use la IP real del cliente.
NODE_ENV=
TRUST_PROXY=0

# Llave para cifrar en la base las credenciales y llaves .p12 de Hacienda de cada empresa (mínimo 32
# caracteres; generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# NO cambiarla después: lo ya guardado no se podría descifrar.
EINVOICE_SECRET=

# Prueba con Hacienda desde la terminal (npm run einvoice:sandbox). En desarrollo, SOLO las de PRUEBAS.
# Las de cada empresa se cargan en la app (Configuración → Facturación electrónica), no aquí.
# La llave .p12 va fuera del repo y fuera de OneDrive; aquí solo la ruta y su PIN.
HACIENDA_ENV=pruebas
HACIENDA_USER=
HACIENDA_PASSWORD=
HACIENDA_P12_PATH=
HACIENDA_P12_PIN=
# PIN con # u otros símbolos: entre comillas simples, p. ej. HACIENDA_P12_PIN='12#34'
# Cédula del proveedor del sistema (ProveedorSistemas); por defecto, la del titular de la llave
HACIENDA_PROVEEDOR=
# Solo para npm run einvoice:sandbox: ubicación registrada en Hacienda (provincia-cantón-distrito)
HACIENDA_TEST_UBICACION=
# Solo para npm run einvoice:sandbox: actividad inscrita, con su punto (ej. 6201.0). Vacía = se busca en la API pública
HACIENDA_ACTIVITY=

# Modo demo (botón "Probar la demo" en el login): 1 = activo. Solo en el servidor de demostración.
DEMO_ENABLED=
# Registro público de empresas: 1 = cerrado (la página de registro avisa "abre muy pronto"). Las invitaciones siguen.
REGISTRATION_CLOSED=
# Cobro de suscripciones: 1 = activo (prueba de 14 días, avisos, 3 días de gracia y SOLO LECTURA al vencer).
# Apagado, nadie vence. Prender solo cuando se pueda pagar (fase C2 en adelante).
BILLING_ENABLED=
# ONVO Pay (cobro con tarjeta, C2). En desarrollo, llaves de PRUEBA (onvo_test_...): sin dinero real.
# La pública la usa el navegador para registrar la tarjeta directo en ONVO; la secreta, solo el servidor.
ONVO_SECRET_KEY=
ONVO_PUBLISHABLE_KEY=
# Número SINPE Móvil al que se transfiere (C3). Vacío = el de ONVO (+50670196686); soporte de ONVO puede dar uno propio.
ONVO_SINPE_NUMBER=
# Solo para npm run owner (scripts/make-platform-owner.ts) si no se pasa la clave como argumento
OWNER_PASSWORD=
# 1 = apaga el límite de intentos (las pruebas lo ponen solas en jest.setup.ts; nunca en producción)
RATE_LIMIT_OFF=
