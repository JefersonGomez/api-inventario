generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(EMPLOYE)
  createdAt    DateTime        @default(now()) // Corregido: createAt -> createdAt
  avatarUrl    String?
  isActive     Boolean         @default(true)
  movements    StockMovement[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  auditLogs AuditLog[]
  refreshTokens RefreshToken[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    
  description String?
  deletedAt    DateTime?
  products    Product[]
}

model Supplier {
  id             String          @id @default(uuid())
  name           String          @unique
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id                   String              @id @default(uuid())
  sku                  String              
  barcode              String?             
  name                 String
  description          String?
  price                Decimal             @db.Decimal(10, 2)
  stock                Int                 @default(0)
  minStock             Int                 @default(0)
  categoryId           String
  supplierId           String?
  deletedAt            DateTime?
  category             Category            @relation(fields: [categoryId], references: [id])
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  movements            StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequests     PurchaseRequest[]
  createdAt            DateTime            @default(now()) // Corregido: createAt -> createdAt
  updatedAt            DateTime            @updatedAt      // Corregido: updateAt -> updatedAt
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  userId    String
  type      MovementType
  quantity  Int
  reason    String?
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
}

model PurchaseRequest {
  id            String                @id @default(uuid())
  productId     String
  requestedById String
  quantity      Int
  reason        String?
  status        PurchaseRequestStatus @default(PENDING)
  expiresAt       DateTime?
  purchaseOrderId String? 
  createdAt     DateTime              @default(now())
  product       Product               @relation(fields: [productId], references: [id])
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])

}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  createdById String
  status      PurchaseOrderStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  receivedAt  DateTime?
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]
  fulfilledRequests PurchaseRequest[] 
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  
}

model AuditLog{
  id String @id @default(uuid())
  userId String
  action String
  entityType String
  entityId String
  changes Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id String @id @default(uuid())
  userId String
  tokenHash String
  expiresAt DateTime
  revoked Boolean @default(false)
  createdAt DateTime @default(now())
  User User  @relation(fields: [userId], references: [id])
}