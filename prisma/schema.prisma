generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

// Roles fijos; los permisos de cada uno viven en src/config/permissions.ts. EMPLOYE = "Bodega".
enum Role {
  ADMIN
  MANAGER // encargado / supervisor
  EMPLOYE // bodega
  CASHIER
  ACCOUNTANT
}

// Moneda en la que la empresa muestra sus montos (los valores se guardan sin conversión)
enum CurrencyCode {
  CRC
  USD
}

// Plan de la cuenta del dueño; los límites viven en src/config/plans.ts
enum PlanCode {
  BASIC
  PRO
  BUSINESS
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// Sucursal = local que vende (tiene cajas y su código en los comprobantes); bodega = solo almacena
enum LocationType {
  BRANCH
  WAREHOUSE
}

// De dónde salió un movimiento de stock; con sourceId apunta al documento (orden, venta, conteo...)
enum MovementSource {
  MANUAL // registrado a mano en Movimientos
  INITIAL // stock inicial al crear o importar el producto
  PURCHASE_RECEIPT // recepción de una orden de compra (sourceId = orden)
  SALE
  RETURN
  COUNT
  TRANSFER
}

// Unidad de medida; se mapea a los códigos de Hacienda (Unid, kg, g, L, mL, m, cm, m²).
// UNIT solo admite cantidades enteras; las demás hasta 3 decimales.
enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
  M
  CM
  M2
}

// Tarifa de IVA del producto (el precio la incluye: es precio de góndola)
enum TaxRate {
  EXEMPT
  RATE_1
  RATE_2
  RATE_4
  RATE_13
}

// Tipo de identificación (Hacienda: 01 física, 02 jurídica, 03 DIMEX, 04 NITE; extranjero = documento del exterior)
enum IdType {
  FISICA
  JURIDICA
  DIMEX
  NITE
  EXTRANJERO
}

// Comprobantes (Hacienda: 01 factura, 02 nota de débito, 03 nota de crédito, 04 tiquete)
enum DocumentType {
  INVOICE
  DEBIT_NOTE
  CREDIT_NOTE
  TICKET
}

// Condición de venta (Hacienda: 01 contado, 02 crédito)
enum SaleCondition {
  CASH
  CREDIT
}

enum PaymentMethod {
  CASH
  CARD
  SINPE
  TRANSFER
  OTHER
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  PENDING
  PARTIAL // llegó una parte; se sigue recibiendo o se cierra
  RECEIVED
  CLOSED // cerrada con lo pendiente cancelado (el proveedor ya no trae el resto)
  CANCELLED // cancelada sin haber recibido nada
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  passwordHash       String
  createdAt          DateTime          @default(now()) // Corregido: createAt -> createdAt
  termsAcceptedAt    DateTime? // cuándo aceptó los términos y la política de privacidad
  termsVersion       String? // versión que aceptó (src/config/legal.ts)
  isPlatformOwner    Boolean           @default(false) // dueño de la plataforma; solo se activa con scripts/make-platform-owner.ts
  avatarUrl          String?
  phone              String?
  company            String?
  isActive           Boolean           @default(true) // cuenta suspendida a nivel plataforma
  plan               PlanCode          @default(BASIC)
  lastCompanyId      String? // empresa que se abre al iniciar sesión
  memberships        Membership[]
  invitationsSent    Invitation[]
  ownedCompanies     Company[]         @relation("CompanyOwner")
  movements          StockMovement[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  transfersSent      StockTransfer[]   @relation("TransferSentBy")
  countsCreated      StockCount[]      @relation("CountCreatedBy")
  countsClosed       StockCount[]      @relation("CountClosedBy")
  transfersReceived  StockTransfer[]   @relation("TransferReceivedBy")
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  comments           Comment[]
  documents          Document[]
  cashSessionsOpened CashSession[]     @relation("SessionOpenedBy")
  cashSessionsClosed CashSession[]     @relation("SessionClosedBy")
  cashSessionsReconciled CashSession[] @relation("SessionReconciledBy")
  cashMovements      CashMovement[]
  negativesReported  StockNegative[] @relation("NegativeReportedBy")
  negativesAuthorized StockNegative[] @relation("NegativeAuthorizedBy")
  negativesResolved  StockNegative[] @relation("NegativeResolvedBy")
  discountsAuthorized Document[]     @relation("DiscountAuthorizedBy")
  creditsAuthorized   Document[]     @relation("CreditAuthorizedBy")
  returnsAuthorized   Document[]     @relation("ReturnAuthorizedBy")
  customerPayments    CustomerPayment[]
}

model Category {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  name        String
  description String?
  deletedAt   DateTime?
  products    Product[]
  counts      StockCount[]

  @@index([companyId])
}

model Supplier {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  idType         IdType?
  idNumber       String? // cédula/DIMEX/NITE sin guiones
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, name])
}

model Product {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  sku                String
  barcode            String?
  name               String
  description        String?
  price              Decimal             @db.Decimal(10, 2) // incluye IVA
  unit               UnitOfMeasure       @default(UNIT)
  taxRate            TaxRate             @default(RATE_13)
  cabys              String? // código CABYS de 13 dígitos (lo exige la factura electrónica)
  groupId            String? // variante de un producto base (talla, color...); null = producto suelto
  group              ProductGroup?       @relation(fields: [groupId], references: [id])
  attributes         Json? // valores de la variante: { "Talla": "M", "Color": "Rojo" }
  documentLines      DocumentLine[]
  pendingReview      Boolean             @default(false) // importado con datos faltantes (p. ej. sin precio): "Por completar"
  cost               Decimal?            @db.Decimal(12, 4) // costo promedio ponderado; null = sin costo conocido
  stock              Decimal             @default(0) @db.Decimal(14, 3) // total de todas las ubicaciones (suma de ProductStock)
  minStock           Decimal             @default(0) @db.Decimal(14, 3) // mínimo en CADA ubicación donde se maneja
  stocks             ProductStock[]
  negatives          StockNegative[]
  transferItems      StockTransferItem[]
  countItems         StockCountItem[]
  // alimentos, medicinas...: el stock se lleva por lote con su vencimiento y las salidas toman el que vence antes
  tracksLots         Boolean             @default(false)
  lots               ProductLot[]
  categoryId         String
  supplierId         String?
  deletedAt          DateTime?
  expirationDate     DateTime?
  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseRequests   PurchaseRequest[]
  createdAt          DateTime            @default(now()) // Corregido: createAt -> createdAt
  updatedAt          DateTime            @updatedAt // Corregido: updateAt -> updatedAt

  @@index([companyId])
}

model StockMovement {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  productId  String
  userId     String
  type       MovementType
  quantity   Decimal        @db.Decimal(14, 3)
  reason     String?
  source     MovementSource @default(MANUAL)
  sourceId   String?
  locationId String // dónde ocurrió
  lots       Json? // productos con lotes: [{ code, expiresAt, quantity }] (una salida puede tocar varios)
  location   Location       @relation(fields: [locationId], references: [id])
  createdAt  DateTime       @default(now())
  product    Product        @relation(fields: [productId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, source, sourceId])
  @@index([locationId])
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  productId       String
  requestedById   String
  quantity        Decimal               @db.Decimal(14, 3)
  reason          String?
  status          PurchaseRequestStatus @default(PENDING)
  expiresAt       DateTime?
  purchaseOrderId String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  product         Product               @relation(fields: [productId], references: [id])
  requestedBy     User                  @relation(fields: [requestedById], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  comments        Comment[]

  @@index([companyId])
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  supplierId        String
  createdById       String
  status            PurchaseOrderStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  receivedAt        DateTime?
  emailedAt         DateTime? // último envío al proveedor
  cancelReason      String? // motivo al cancelar o cerrar
  locationId        String // a dónde entra la mercadería al recibirla
  location          Location            @relation(fields: [locationId], references: [id])
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  createdBy         User                @relation(fields: [createdById], references: [id])
  items             PurchaseOrderItem[]
  fulfilledRequests PurchaseRequest[]
  comments          Comment[]

  @@index([companyId])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(14, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 3) // suma de lo recibido en todas las recepciones
  unitCost         Decimal       @db.Decimal(10, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  companyId String? // empresa de la sesión: refrescar no la cambia
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

// Eventos dirigidos a un usuario ("tu solicitud fue aprobada"). Los avisos de estado
// (stock bajo, por vencer...) no se guardan: se calculan en notifications.service.ts.
model Notification {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String
  type      String
  title     String
  meta      Json?
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, companyId, createdAt])
}

// Hilo de comentarios de una solicitud o de una orden: exactamente uno de los dos ids va con valor
model Comment {
  id                String           @id @default(uuid())
  authorId          String
  body              String
  purchaseRequestId String?
  purchaseOrderId   String?
  createdAt         DateTime         @default(now())
  author            User             @relation(fields: [authorId], references: [id])
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseRequestId, createdAt])
  @@index([purchaseOrderId, createdAt])
}

// Empresa (tenant). Todo dato de negocio pertenece a una; los usuarios entran por Membership.
// El plan del dueño (owner.plan) define cuántas empresas puede tener y sus límites.
model Company {
  id                    String             @id @default(uuid())
  name                  String // nombre comercial (el que se ve en la app)
  currency              CurrencyCode       @default(CRC)
  cashCodeDays          Int                @default(30) // días que dura un código de caja (y que queda fijo tras cambiarlo)
  posShowStock          Boolean            @default(true) // el POS muestra la cantidad en stock (si no: disponible/agotado)
  returnDays            Int                @default(30) // días para devolver una venta
  onboardingDismissedAt DateTime? // ocultó la guía de primeros pasos
  // datos fiscales (emisor de los comprobantes); todos opcionales hasta que la empresa facture
  legalName             String? // razón social o nombre de la persona física
  idType                IdType?
  idNumber              String?
  economicActivity      String? // código de actividad económica ante Hacienda
  invoiceEmail          String? // correo que aparece en los comprobantes
  phone                 String?
  province              String? // código Hacienda: 1 San José … 7 Limón
  canton                String? // código de 2 dígitos
  district              String? // código de 2 dígitos
  addressDetail         String? // otras señas
  suspendedAt           DateTime? // suspendida por el dueño de la plataforma (p. ej. falta de pago)
  suspensionReason      String?
  ownerId               String
  owner                 User               @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  memberships           Membership[]
  invitations           Invitation[]
  categories            Category[]
  suppliers             Supplier[]
  products              Product[]
  movements             StockMovement[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  productGroups         ProductGroup[]
  customers             Customer[]
  documents             Document[]
  documentSeqs          DocumentSequence[]
  locations             Location[]
  productStocks         ProductStock[]
  transfers             StockTransfer[]
  stockCounts           StockCount[]
  productLots           ProductLot[]
  aiUsages              AiUsage[]
  dailySummaries        DailySummary[]
  cashRegisters         CashRegister[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  stockNegatives        StockNegative[]
  discountTypes         DiscountType[]
  installments          Installment[]
  customerPayments      CustomerPayment[]

  @@index([ownerId])
}

// Producto base que agrupa variantes. Cada variante es un Product normal (su SKU, código, precio y
// stock) con groupId y sus valores en attributes; así stock, compras, POS y facturas no cambian.
model ProductGroup {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  attributeNames String[] // nombres de los atributos, en orden: ["Talla", "Color"]
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  products       Product[]

  @@index([companyId])
}

// Cliente de la empresa (venta a su nombre, factura, crédito)
model Customer {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id])
  name             String
  idType           IdType?
  idNumber         String? // sin guiones; único por empresa entre los activos (índice parcial)
  email            String?
  phone            String?
  address          String?
  economicActivity String?
  creditLimit      Decimal?   @db.Decimal(14, 2) // null = sin crédito
  creditDays       Int? // plazo de crédito
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        Document[]
  installments     Installment[]
  payments         CustomerPayment[]

  @@index([companyId])
}

// Comprobante emitido (tiquete, factura, notas). INMUTABLE: un trigger de Postgres impide editarlo o
// borrarlo; se corrige con una nota de crédito/débito que lo referencia. Los montos de las líneas van
// SIN IVA (el precio del producto lo incluye y se separa al emitir).
model Document {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  type                DocumentType
  branchCode          String            @default("001") // sucursal (3 dígitos) — Bloque 4
  terminalCode        String            @default("00001") // caja/terminal (5 dígitos) — Bloque 7
  number              Int // consecutivo por empresa + tipo + sucursal + terminal
  consecutive         String // formato Hacienda de 20 dígitos: sucursal + terminal + tipo + número
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])
  saleCondition       SaleCondition     @default(CASH)
  creditDays          Int?
  currency            CurrencyCode
  subtotal            Decimal           @db.Decimal(18, 5) // sin IVA, después de descuentos
  discountTotal       Decimal           @db.Decimal(18, 5)
  taxTotal            Decimal           @db.Decimal(18, 5)
  total               Decimal           @db.Decimal(18, 5)
  referenceDocumentId String? // nota de crédito/débito → documento que corrige
  referenceDocument   Document?         @relation("DocumentReference", fields: [referenceDocumentId], references: [id])
  referencedBy        Document[]        @relation("DocumentReference")
  referenceReason     String?
  notes               String?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id])
  discountAuthorizedById String? // encargado que autorizó los descuentos (POS, con su código)
  discountAuthorizedBy   User?          @relation("DiscountAuthorizedBy", fields: [discountAuthorizedById], references: [id])
  creditAuthorizedById   String? // encargado que autorizó la venta a crédito (POS, con su código)
  creditAuthorizedBy     User?          @relation("CreditAuthorizedBy", fields: [creditAuthorizedById], references: [id])
  returnAuthorizedById   String? // nota de crédito: encargado que autorizó la devolución (con su código)
  returnAuthorizedBy     User?          @relation("ReturnAuthorizedBy", fields: [returnAuthorizedById], references: [id])
  installments           Installment[]
  issuedAt            DateTime          @default(now())
  cashSessionId       String? // turno de caja donde se vendió (POS)
  cashSession         CashSession?      @relation(fields: [cashSessionId], references: [id])
  lines               DocumentLine[]
  negatives           StockNegative[]
  payments            DocumentPayment[]

  @@unique([companyId, type, branchCode, terminalCode, number])
  @@index([companyId, issuedAt])
}

model DocumentLine {
  id          String        @id @default(uuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id])
  lineNumber  Int
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  description String
  cabys       String?
  unit        UnitOfMeasure
  quantity    Decimal       @db.Decimal(14, 3)
  unitPrice   Decimal       @db.Decimal(18, 5) // sin IVA
  discount    Decimal       @db.Decimal(18, 5) // monto, sin IVA
  discountLabel String? // naturaleza del descuento (Hacienda): el tipo de descuento usado
  // nota de crédito: la línea de la venta que se devuelve y en qué estado volvió el producto
  sourceLineId    String?
  sourceLine      DocumentLine?    @relation("LineReturns", fields: [sourceLineId], references: [id])
  returns         DocumentLine[]   @relation("LineReturns")
  returnCondition ReturnCondition?
  taxRate     TaxRate
  taxAmount   Decimal       @db.Decimal(18, 5)
  subtotal    Decimal       @db.Decimal(18, 5) // quantity × unitPrice − discount
  total       Decimal       @db.Decimal(18, 5) // subtotal + taxAmount

  @@unique([documentId, lineNumber])
}

model DocumentPayment {
  id         String        @id @default(uuid())
  documentId String
  document   Document      @relation(fields: [documentId], references: [id])
  method     PaymentMethod
  amount     Decimal       @db.Decimal(18, 5)
  reference  String? // n.º de autorización del datáfono o comprobante SINPE
  tendered   Decimal?      @db.Decimal(18, 2) // efectivo: lo que entregó el cliente (vuelto = tendered − amount)
}

// Último número usado por empresa + tipo + sucursal + terminal (se incrementa en la misma transacción)
model DocumentSequence {
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  type         DocumentType
  branchCode   String
  terminalCode String
  last         Int          @default(0)

  @@id([companyId, type, branchCode, terminalCode])
}

// Usuario dentro de una empresa: su rol y si está activo ahí (un usuario puede estar en varias)
model Membership {
  id                 String    @id @default(uuid())
  userId             String
  companyId          String
  role               Role      @default(EMPLOYE)
  isActive           Boolean   @default(true)
  // ajustes de esta persona sobre los permisos de su rol (claves de src/config/permissions.ts)
  grantedPermissions String[]  @default([])
  revokedPermissions String[]  @default([])
  // Código de caja (abrir caja y, si tiene permiso, autorizar descuentos/anulaciones); bcrypt. Por empresa.
  // Lo genera el admin (o el encargado, para cajeros); la persona puede cambiarlo y después queda fijo
  // hasta que pase el plazo (pinSetBySelf + pinSetAt) o el admin genere otro.
  pinHash            String?
  pinSetAt           DateTime?
  pinSetBySelf       Boolean   @default(false)
  // ubicaciones donde trabaja (vacío = todas); el cajero elige en cuál está al entrar
  locationIds        String[]  @default([])
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id])
  company            Company   @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

// Invitación a una empresa: el link lleva un token aleatorio; acá solo se guarda su hash (sha256)
model Invitation {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        Role      @default(EMPLOYE)
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
}

// Sucursal o bodega de una empresa. El stock de cada producto se lleva por ubicación (ProductStock).
// No se borran: se desactivan (los movimientos y comprobantes las siguen referenciando).
model Location {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  type           LocationType    @default(BRANCH)
  code           String? // sucursales: 3 dígitos para el consecutivo de los comprobantes ("001")
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stocks         ProductStock[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")
  counts         StockCount[]
  lots           ProductLot[]
  cashRegisters  CashRegister[]
  negatives      StockNegative[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Existencias de un producto en una ubicación. Hay fila desde que el producto se movió ahí alguna
// vez: así "bajo mínimo" solo aplica donde el producto se maneja.
model ProductStock {
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@id([productId, locationId])
  @@index([companyId, locationId])
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// Transferencia entre ubicaciones en dos pasos: al enviarla sale el stock del origen (queda en
// tránsito); al recibirla entra al destino. Cancelarla antes de recibir devuelve el stock al origen.
model StockTransfer {
  id             String              @id @default(uuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  fromLocationId String
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  status         TransferStatus      @default(IN_TRANSIT)
  notes          String?
  sentById       String
  sentBy         User                @relation("TransferSentBy", fields: [sentById], references: [id])
  receivedById   String?
  receivedBy     User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  sentAt         DateTime            @default(now())
  closedAt       DateTime? // recibida o cancelada
  items          StockTransferItem[]

  @@index([companyId, status])
}

model StockTransferItem {
  id               String        @id @default(uuid())
  transferId       String
  transfer         StockTransfer @relation(fields: [transferId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal       @db.Decimal(14, 3) // enviado
  receivedQuantity Decimal?      @db.Decimal(14, 3) // lo que llegó; la diferencia es faltante (sale del inventario)
  lots             Json? // productos con lotes: los que salieron del origen (en orden de vencimiento)
}

enum StockCountStatus {
  OPEN
  CLOSED
  CANCELLED
}

// Conteo físico de una ubicación (todos los productos o una categoría). Se puede seguir vendiendo
// mientras dura: cada línea guarda lo que decía el sistema al momento de contarla, y al cerrar se
// aplica solo la diferencia (contado − sistema de ese momento) con movimientos de origen COUNT.
model StockCount {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id])
  categoryId  String? // null = todos los productos
  category    Category?        @relation(fields: [categoryId], references: [id])
  status      StockCountStatus @default(OPEN)
  notes       String?
  createdById String
  createdBy   User             @relation("CountCreatedBy", fields: [createdById], references: [id])
  closedById  String?
  closedBy    User?            @relation("CountClosedBy", fields: [closedById], references: [id])
  createdAt   DateTime         @default(now())
  closedAt    DateTime?
  items       StockCountItem[]

  @@index([companyId, status])
}

model StockCountItem {
  id              String     @id @default(uuid())
  countId         String
  count           StockCount @relation(fields: [countId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  countedQuantity Decimal?   @db.Decimal(14, 3) // null = todavía sin contar (al cerrar no se ajusta)
  systemQuantity  Decimal?   @db.Decimal(14, 3) // lo que decía el sistema al contarlo
  countedAt       DateTime?

  @@unique([countId, productId])
}

// Lote de un producto en una ubicación (solo productos con tracksLots). La suma de sus lotes es el
// ProductStock de esa ubicación. Las salidas consumen primero el que vence antes (FEFO).
model ProductLot {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  code       String // código del lote del proveedor (o "SIN-LOTE" en ajustes sin dato)
  expiresAt  DateTime? // null = sin vencimiento conocido (sale de último)
  quantity   Decimal   @default(0) @db.Decimal(14, 3)
  createdAt  DateTime  @default(now())

  @@unique([productId, locationId, code])
  @@index([companyId, expiresAt])
}

enum AiFeature {
  CHAT // asistente IA
  IMPORT // ayuda para importar productos
  DAILY_SUMMARY // resumen del día
}

// Medidor de consumo de IA (Bloque 6A): cada consulta a Gemini con sus tokens y su costo estimado.
// Solo lo ve el dueño de la plataforma; sirve para el presupuesto mensual (PlatformSetting "aiBudget").
model AiUsage {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  userId       String?
  feature      AiFeature
  model        String
  inputTokens  Int
  outputTokens Int // incluye los tokens de "pensamiento"
  costUsd      Decimal   @db.Decimal(12, 6)
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Ajustes de la plataforma (del dueño), por clave: p. ej. "aiBudget" = { monthlyUsd, alertPercent, alertedMonth }
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Resumen del día con IA (Bloque 6D): se guarda cada uno (también los que se vuelven a generar) para
// llevar un historial y descargarlo. date = día del navegador (AAAA-MM-DD).
model DailySummary {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  date        String
  text        String
  data        Json // los números del día que se le pasaron a la IA
  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, date])
}

// Caja (terminal) de una sucursal (Bloque 7). El terminalCode (5 dígitos) va en el consecutivo de sus tiquetes.
model CashRegister {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  locationId   String
  location     Location      @relation(fields: [locationId], references: [id])
  name         String
  terminalCode String // "00001", único por sucursal
  ticketWidth  Int           @default(80) // tiquete térmico: 80 o 58 mm
  customerDisplay Boolean      @default(false) // segunda pantalla mirando al cliente
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     CashSession[]

  @@unique([locationId, terminalCode])
  @@index([companyId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Turno de caja: se abre con el código del cajero y un monto inicial y se cierra con arqueo.
// Una abierta por caja y una por persona a la vez (índices únicos parciales en la migración).
model CashSession {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  registerId    String
  register      CashRegister      @relation(fields: [registerId], references: [id])
  openedById    String
  openedBy      User              @relation("SessionOpenedBy", fields: [openedById], references: [id])
  openingAmount Decimal           @db.Decimal(18, 2)
  status        CashSessionStatus @default(OPEN)
  openedAt      DateTime          @default(now())
  closedById    String?
  closedBy      User?             @relation("SessionClosedBy", fields: [closedById], references: [id])
  closedAt      DateTime?
  expectedCash  Decimal?          @db.Decimal(18, 2) // al cerrar: inicial + ventas en efectivo + entradas − retiros − devoluciones
  countedCash   Decimal?          @db.Decimal(18, 2)
  difference    Decimal?          @db.Decimal(18, 2) // contado − esperado (negativo = faltante)
  denominations Json? // conteo por denominación { "20000": 3, ... }
  closingNote   String?
  // arqueo (segundo paso, la jefa de caja con el cajero): cierre ciego, el cajero no ve el esperado
  reconciledById String?
  reconciledBy   User?             @relation("SessionReconciledBy", fields: [reconciledById], references: [id])
  reconciledAt   DateTime?
  cardDeclared   Decimal?          @db.Decimal(18, 2) // total del cierre en papel del datáfono (opcional, para comparar)
  reconcileNote  String?
  documents     Document[]
  movements     CashMovement[]
  customerPayments CustomerPayment[]

  @@index([companyId, status])
}

enum CashMovementType {
  IN // entrada de efectivo (p. ej. más cambio)
  OUT // retiro (p. ej. pago a un proveedor, depósito)
}

model CashMovement {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  sessionId String
  session   CashSession      @relation(fields: [sessionId], references: [id])
  type      CashMovementType
  amount    Decimal          @db.Decimal(18, 2)
  reason    String
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@index([sessionId])
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum DiscountScope {
  LINE
  TOTAL
  BOTH
}

// Tipo de descuento del POS (Bloque 7B): lo crea el admin y el cajero lo elige. Siempre lo autoriza un
// encargado con su código. value null = el cajero escribe cuánto, hasta maxPercent de lo que descuenta.
model DiscountType {
  id         String        @id @default(uuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  name       String
  kind       DiscountKind
  value      Decimal?      @db.Decimal(14, 2) // % o monto fijo; null = libre
  maxPercent Decimal?      @db.Decimal(5, 2) // tope de los libres
  appliesTo  DiscountScope @default(BOTH)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
}

enum NegativeStatus {
  OPEN
  RESOLVED
}

// Negativa: venta de un producto que el sistema tenía sin stock suficiente (descuadre de inventario).
// La autoriza un encargado con su código en la caja; inventario la revisa y la resuelve (conteo/ajuste).
model StockNegative {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  locationId       String
  location         Location       @relation(fields: [locationId], references: [id])
  documentId       String
  document         Document       @relation(fields: [documentId], references: [id])
  quantity         Decimal        @db.Decimal(14, 3) // lo vendido de más (lo que quedó en negativo)
  stockBefore      Decimal        @db.Decimal(14, 3) // lo que decía el sistema antes de la venta
  reportedById     String // el cajero
  reportedBy       User           @relation("NegativeReportedBy", fields: [reportedById], references: [id])
  authorizedById   String // el encargado que dio su código
  authorizedBy     User           @relation("NegativeAuthorizedBy", fields: [authorizedById], references: [id])
  status           NegativeStatus @default(OPEN)
  resolvedById     String?
  resolvedBy       User?          @relation("NegativeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  resolution       String? // qué se encontró / qué se hizo
  countedQuantity  Decimal?       @db.Decimal(14, 3) // si al resolver se contó: cantidad real en la sucursal
  createdAt        DateTime       @default(now())

  @@index([companyId, status])
}

enum CreditFrequency {
  BIWEEKLY // quincenal
  MONTHLY
}

// Cuota de una venta a crédito (7B-2): plan quincenal o mensual, hasta 6 meses, sin intereses.
// paid sube con los abonos (a la cuota más vieja primero). Vencida = dueDate < hoy y paid < amount.
model Installment {
  id         String          @id @default(uuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  documentId String
  document   Document        @relation(fields: [documentId], references: [id])
  number     Int
  frequency  CreditFrequency
  dueDate    DateTime        @db.Date
  amount     Decimal         @db.Decimal(18, 2)
  paid       Decimal         @default(0) @db.Decimal(18, 2)
  notifiedAt DateTime? // aviso de vencida ya enviado

  @@unique([documentId, number])
  @@index([companyId, customerId, dueDate])
}

// Abono de un cliente a su crédito: en la caja (cashSessionId, el efectivo entra al arqueo) o desde
// Cuentas por cobrar sin caja (con referencia). Guarda el saldo antes y después para el recibo.
model CustomerPayment {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(18, 2)
  method        PaymentMethod
  reference     String?
  tendered      Decimal?      @db.Decimal(18, 2)
  balanceBefore Decimal       @db.Decimal(18, 2)
  balanceAfter  Decimal       @db.Decimal(18, 2)
  note          String?
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([companyId, customerId])
  @@index([cashSessionId])
}

// Estado del producto devuelto: en buen estado vuelve al stock; dañado no vuelve (merma)
enum ReturnCondition {
  GOOD
  DAMAGED
}
