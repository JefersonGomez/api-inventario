generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

// Roles fijos; los permisos de cada uno viven en src/config/permissions.ts. EMPLOYE = "Bodega".
enum Role {
  ADMIN
  MANAGER // encargado / supervisor
  EMPLOYE // bodega
  CASHIER
  ACCOUNTANT
}

// Moneda en la que la empresa muestra sus montos (los valores se guardan sin conversión)
enum CurrencyCode {
  CRC
  USD
}

// Plan de la cuenta del dueño; los límites viven en src/config/plans.ts
enum PlanCode {
  BASIC
  PRO
  BUSINESS
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// De dónde salió un movimiento de stock; con sourceId apunta al documento (orden, venta, conteo...)
enum MovementSource {
  MANUAL // registrado a mano en Movimientos
  INITIAL // stock inicial al crear o importar el producto
  PURCHASE_RECEIPT // recepción de una orden de compra (sourceId = orden)
  SALE
  RETURN
  COUNT
  TRANSFER
}

// Unidad de medida; se mapea a los códigos de Hacienda (Unid, kg, g, L, mL, m, cm, m²).
// UNIT solo admite cantidades enteras; las demás hasta 3 decimales.
enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
  M
  CM
  M2
}

// Tarifa de IVA del producto (el precio la incluye: es precio de góndola)
enum TaxRate {
  EXEMPT
  RATE_1
  RATE_2
  RATE_4
  RATE_13
}

// Tipo de identificación (Hacienda: 01 física, 02 jurídica, 03 DIMEX, 04 NITE; extranjero = documento del exterior)
enum IdType {
  FISICA
  JURIDICA
  DIMEX
  NITE
  EXTRANJERO
}

// Comprobantes (Hacienda: 01 factura, 02 nota de débito, 03 nota de crédito, 04 tiquete)
enum DocumentType {
  INVOICE
  DEBIT_NOTE
  CREDIT_NOTE
  TICKET
}

// Condición de venta (Hacienda: 01 contado, 02 crédito)
enum SaleCondition {
  CASH
  CREDIT
}

enum PaymentMethod {
  CASH
  CARD
  SINPE
  TRANSFER
  OTHER
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now()) // Corregido: createAt -> createdAt
  termsAcceptedAt  DateTime? // cuándo aceptó los términos y la política de privacidad
  termsVersion     String? // versión que aceptó (src/config/legal.ts)
  isPlatformOwner  Boolean           @default(false) // dueño de la plataforma; solo se activa con scripts/make-platform-owner.ts
  avatarUrl        String?
  phone            String?
  company          String?
  isActive         Boolean           @default(true) // cuenta suspendida a nivel plataforma
  plan             PlanCode          @default(BASIC)
  lastCompanyId    String? // empresa que se abre al iniciar sesión
  memberships      Membership[]
  invitationsSent  Invitation[]
  ownedCompanies   Company[]         @relation("CompanyOwner")
  movements        StockMovement[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  comments         Comment[]
  documents        Document[]
}

model Category {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  deletedAt   DateTime?
  products    Product[]

  @@index([companyId])
}

model Supplier {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  idType         IdType?
  idNumber       String? // cédula/DIMEX/NITE sin guiones
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, name])
}

model Product {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  sku                String
  barcode            String?
  name               String
  description        String?
  price              Decimal             @db.Decimal(10, 2) // incluye IVA
  unit               UnitOfMeasure       @default(UNIT)
  taxRate            TaxRate             @default(RATE_13)
  cabys              String? // código CABYS de 13 dígitos (lo exige la factura electrónica)
  groupId            String? // variante de un producto base (talla, color...); null = producto suelto
  group              ProductGroup?       @relation(fields: [groupId], references: [id])
  attributes         Json? // valores de la variante: { "Talla": "M", "Color": "Rojo" }
  documentLines      DocumentLine[]
  pendingReview      Boolean             @default(false) // importado con datos faltantes (p. ej. sin precio): "Por completar"
  cost               Decimal?            @db.Decimal(12, 4) // costo promedio ponderado; null = sin costo conocido
  stock              Decimal             @default(0) @db.Decimal(14, 3)
  minStock           Decimal             @default(0) @db.Decimal(14, 3)
  categoryId         String
  supplierId         String?
  deletedAt          DateTime?
  expirationDate     DateTime?
  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseRequests   PurchaseRequest[]
  createdAt          DateTime            @default(now()) // Corregido: createAt -> createdAt
  updatedAt          DateTime            @updatedAt // Corregido: updateAt -> updatedAt

  @@index([companyId])
}

model StockMovement {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  productId String
  userId    String
  type      MovementType
  quantity  Decimal        @db.Decimal(14, 3)
  reason    String?
  source    MovementSource @default(MANUAL)
  sourceId  String?
  createdAt DateTime       @default(now())
  product   Product        @relation(fields: [productId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, source, sourceId])
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  productId       String
  requestedById   String
  quantity        Decimal               @db.Decimal(14, 3)
  reason          String?
  status          PurchaseRequestStatus @default(PENDING)
  expiresAt       DateTime?
  purchaseOrderId String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  product         Product               @relation(fields: [productId], references: [id])
  requestedBy     User                  @relation(fields: [requestedById], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  comments        Comment[]

  @@index([companyId])
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  supplierId        String
  createdById       String
  status            PurchaseOrderStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  receivedAt        DateTime?
  emailedAt         DateTime? // último envío al proveedor
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  createdBy         User                @relation(fields: [createdById], references: [id])
  items             PurchaseOrderItem[]
  fulfilledRequests PurchaseRequest[]
  comments          Comment[]

  @@index([companyId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  companyId String? // empresa de la sesión: refrescar no la cambia
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

// Eventos dirigidos a un usuario ("tu solicitud fue aprobada"). Los avisos de estado
// (stock bajo, por vencer...) no se guardan: se calculan en notifications.service.ts.
model Notification {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String
  type      String
  title     String
  meta      Json?
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, companyId, createdAt])
}

// Hilo de comentarios de una solicitud o de una orden: exactamente uno de los dos ids va con valor
model Comment {
  id                String           @id @default(uuid())
  authorId          String
  body              String
  purchaseRequestId String?
  purchaseOrderId   String?
  createdAt         DateTime         @default(now())
  author            User             @relation(fields: [authorId], references: [id])
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseRequestId, createdAt])
  @@index([purchaseOrderId, createdAt])
}

// Empresa (tenant). Todo dato de negocio pertenece a una; los usuarios entran por Membership.
// El plan del dueño (owner.plan) define cuántas empresas puede tener y sus límites.
model Company {
  id               String             @id @default(uuid())
  name             String // nombre comercial (el que se ve en la app)
  currency         CurrencyCode       @default(CRC)
  // datos fiscales (emisor de los comprobantes); todos opcionales hasta que la empresa facture
  legalName        String? // razón social o nombre de la persona física
  idType           IdType?
  idNumber         String?
  economicActivity String? // código de actividad económica ante Hacienda
  invoiceEmail     String? // correo que aparece en los comprobantes
  phone            String?
  province         String? // código Hacienda: 1 San José … 7 Limón
  canton           String? // código de 2 dígitos
  district         String? // código de 2 dígitos
  addressDetail    String? // otras señas
  suspendedAt      DateTime? // suspendida por el dueño de la plataforma (p. ej. falta de pago)
  suspensionReason String?
  ownerId          String
  owner            User               @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      Membership[]
  invitations      Invitation[]
  categories       Category[]
  suppliers        Supplier[]
  products         Product[]
  movements        StockMovement[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  productGroups    ProductGroup[]
  customers        Customer[]
  documents        Document[]
  documentSeqs     DocumentSequence[]

  @@index([ownerId])
}

// Producto base que agrupa variantes. Cada variante es un Product normal (su SKU, código, precio y
// stock) con groupId y sus valores en attributes; así stock, compras, POS y facturas no cambian.
model ProductGroup {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  attributeNames String[] // nombres de los atributos, en orden: ["Talla", "Color"]
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  products       Product[]

  @@index([companyId])
}

// Cliente de la empresa (venta a su nombre, factura, crédito)
model Customer {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id])
  name             String
  idType           IdType?
  idNumber         String? // sin guiones; único por empresa entre los activos (índice parcial)
  email            String?
  phone            String?
  address          String?
  economicActivity String?
  creditLimit      Decimal?   @db.Decimal(14, 2) // null = sin crédito
  creditDays       Int? // plazo de crédito
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        Document[]

  @@index([companyId])
}

// Comprobante emitido (tiquete, factura, notas). INMUTABLE: un trigger de Postgres impide editarlo o
// borrarlo; se corrige con una nota de crédito/débito que lo referencia. Los montos de las líneas van
// SIN IVA (el precio del producto lo incluye y se separa al emitir).
model Document {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  type                DocumentType
  branchCode          String            @default("001") // sucursal (3 dígitos) — Bloque 4
  terminalCode        String            @default("00001") // caja/terminal (5 dígitos) — Bloque 7
  number              Int // consecutivo por empresa + tipo + sucursal + terminal
  consecutive         String // formato Hacienda de 20 dígitos: sucursal + terminal + tipo + número
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])
  saleCondition       SaleCondition     @default(CASH)
  creditDays          Int?
  currency            CurrencyCode
  subtotal            Decimal           @db.Decimal(18, 5) // sin IVA, después de descuentos
  discountTotal       Decimal           @db.Decimal(18, 5)
  taxTotal            Decimal           @db.Decimal(18, 5)
  total               Decimal           @db.Decimal(18, 5)
  referenceDocumentId String? // nota de crédito/débito → documento que corrige
  referenceDocument   Document?         @relation("DocumentReference", fields: [referenceDocumentId], references: [id])
  referencedBy        Document[]        @relation("DocumentReference")
  referenceReason     String?
  notes               String?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id])
  issuedAt            DateTime          @default(now())
  lines               DocumentLine[]
  payments            DocumentPayment[]

  @@unique([companyId, type, branchCode, terminalCode, number])
  @@index([companyId, issuedAt])
}

model DocumentLine {
  id          String        @id @default(uuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id])
  lineNumber  Int
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  description String
  cabys       String?
  unit        UnitOfMeasure
  quantity    Decimal       @db.Decimal(14, 3)
  unitPrice   Decimal       @db.Decimal(18, 5) // sin IVA
  discount    Decimal       @db.Decimal(18, 5) // monto, sin IVA
  taxRate     TaxRate
  taxAmount   Decimal       @db.Decimal(18, 5)
  subtotal    Decimal       @db.Decimal(18, 5) // quantity × unitPrice − discount
  total       Decimal       @db.Decimal(18, 5) // subtotal + taxAmount

  @@unique([documentId, lineNumber])
}

model DocumentPayment {
  id         String        @id @default(uuid())
  documentId String
  document   Document      @relation(fields: [documentId], references: [id])
  method     PaymentMethod
  amount     Decimal       @db.Decimal(18, 5)
}

// Último número usado por empresa + tipo + sucursal + terminal (se incrementa en la misma transacción)
model DocumentSequence {
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  type         DocumentType
  branchCode   String
  terminalCode String
  last         Int          @default(0)

  @@id([companyId, type, branchCode, terminalCode])
}

// Usuario dentro de una empresa: su rol y si está activo ahí (un usuario puede estar en varias)
model Membership {
  id                 String   @id @default(uuid())
  userId             String
  companyId          String
  role               Role     @default(EMPLOYE)
  isActive           Boolean  @default(true)
  // ajustes de esta persona sobre los permisos de su rol (claves de src/config/permissions.ts)
  grantedPermissions String[] @default([])
  revokedPermissions String[] @default([])
  // PIN para autorizar en la caja (descuentos, anulaciones); bcrypt. Por empresa: es de esta membresía
  pinHash            String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  company            Company  @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

// Invitación a una empresa: el link lleva un token aleatorio; acá solo se guarda su hash (sha256)
model Invitation {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        Role      @default(EMPLOYE)
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
}
